# Exact anniversary date in YYYY-MM-DD format (kept on the server)
ANNIVERSARY_DATE=2020-06-15

# Random, private value used to sign short-lived access tokens
SESSION_SECRET=replace-with-a-long-random-secret

# Resend email API settings. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_TO=you@example.com
EMAIL_FROM=Love Notes <notes@your-verified-domain.com>

PORT=3001
